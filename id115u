#!/usr/bin/env bash
# Control an ID115U fitness band (IDO/VeryFit protocol) over BLE using gatttool.
#
# Usage:
#   ./id115u info                     device info (02 01)
#   ./id115u time                     read band clock (02 03)
#   ./id115u settime                  set band clock to local time (03 01)
#   ./id115u mac                      read MAC address (02 04)
#   ./id115u battery                  battery level, voltage, charging state (02 05)
#   ./id115u live                     today's totals: steps, calories, distance, active time (02 a0)
#   ./id115u activity                 today's activity in 15-minute slots (08 03 on 0af1)
#   ./id115u find [seconds]           "find device" vibration (06 04), stopped after N s (default 5)
#   ./id115u alarms [file]            program alarms from a weekly matrix (default alarms.txt)
#   ./id115u vibrate [seconds]        incoming-call alert, cancelled after N s (default 4)
#   ./id115u notify <from> <text>     WhatsApp notification (from+text <= 12 bytes)
#   ./id115u raw <hex> [<hex>...]     write raw commands (padded to 20 bytes); "sleep:N" waits,
#                                     "read:<handle>" reads a characteristic,
#                                     "h:<hex>" writes unpadded to the health channel 0af1
#
# Env: KEEP_LOG=<file> saves the raw gatttool log.
#      MAC (default E7:84:6B:69:A2:8A), RETRIES (default 5), CONNECT_TIMEOUT (seconds, default 20)

set -u

MAC=${MAC:-E7:84:6B:69:A2:8A}
RETRIES=${RETRIES:-5}
CONNECT_TIMEOUT=${CONNECT_TIMEOUT:-20}

WRITE_HANDLE=0x000e   # 0af6 write characteristic (commands)
HEALTH_HANDLE=0x0016  # 0af1 write characteristic (health data requests)
NOTIFY_CCCD=0x0011    # CCCD of 0af7 notify characteristic (command responses)
HEALTH_CCCD=0x0014    # CCCD of 0af2 notify characteristic (health data)

WORK=$(mktemp -d)
trap 'kill $GPID 2>/dev/null; [[ -n ${KEEP_LOG:-} ]] && cp "$WORK/log" "$KEEP_LOG"; rm -rf "$WORK"' EXIT
GPID=

pad() { printf '%-40s' "$1" | tr ' ' 0; }
hex() { printf '%s' "$1" | xxd -p | tr -d '\n'; }
clean() { sed 's/\x1b\[[0-9;]*[A-Za-z]//g' "$1" | tr '\r' '\n'; }

settime_cmd() {
  local y m d H M S w
  read -r y m d H M S w <<< "$(date '+%Y %m %d %H %M %S %u')"
  # year little-endian, month, day, hour, min, sec, weekday (Monday=0)
  pad "$(printf '0301%02x%02x%02x%02x%02x%02x%02x%02x' $((y & 255)) $((y >> 8)) \
    $((10#$m)) $((10#$d)) $((10#$H)) $((10#$M)) $((10#$S)) $((w - 1)))"
}

# One attempt: connect, enable notifications, send commands. Returns 0 if all writes succeeded.
attempt() {
  local fifo=$WORK/in log=$WORK/log cmd n i
  rm -f "$fifo"; mkfifo "$fifo"; : > "$log"
  gatttool -t random -b "$MAC" -I < "$fifo" > "$log" 2>&1 &
  GPID=$!
  exec 3> "$fifo"
  echo connect >&3
  for ((i = 0; i < CONNECT_TIMEOUT * 2; i++)); do
    grep -q "Connection successful" "$log" && break
    sleep 0.5
  done
  if ! grep -q "Connection successful" "$log"; then
    exec 3>&-; kill $GPID 2>/dev/null; wait $GPID 2>/dev/null
    return 1
  fi
  echo "char-write-req $NOTIFY_CCCD 0100" >&3; sleep 0.5
  echo "char-write-req $HEALTH_CCCD 0100" >&3; sleep 0.5
  n=0
  for cmd in "$@"; do
    if [[ $cmd == sleep:* ]]; then sleep "${cmd#sleep:}"; continue; fi
    if [[ $cmd == read:* ]]; then echo "char-read-hnd ${cmd#read:}" >&3; sleep 0.7; continue; fi
    if [[ $cmd == h:* ]]; then
      echo "char-write-req $HEALTH_HANDLE ${cmd#h:}" >&3; n=$((n + 1)); sleep 0.7; continue
    fi
    [[ $cmd == settime ]] && cmd=$(settime_cmd)
    echo "char-write-req $WRITE_HANDLE $(pad "$cmd")" >&3
    n=$((n + 1))
    sleep 0.7
  done
  sleep 1.5
  echo exit >&3; exec 3>&-
  sleep 0.5; kill $GPID 2>/dev/null; wait $GPID 2>/dev/null
  # +2 for the CCCD writes
  [[ $(clean "$log" | grep -c "written successfully") -ge $((n + 2)) ]]
}

send() {
  local r
  for ((r = 1; r <= RETRIES; r++)); do
    if attempt "$@"; then
      # responses from 0af7 are printed bare, health data from 0af2 is prefixed with "af2:"
      clean "$WORK/log" | grep -oE "handle = 0x00[0-9a-f]* value: .*|Characteristic value/descriptor: .*" |
        sed -e 's/handle = 0x0010 value: //' -e 's/handle = 0x0013 value: /af2: /' \
            -e 's|Characteristic value/descriptor: |read: |'
      return 0
    fi
    echo "attempt $r/$RETRIES failed, retrying..." >&2
  done
  echo "giving up after $RETRIES attempts" >&2
  return 1
}

# Find the response line for a given command prefix (e.g. "02 03").
response() { grep -m1 "^$1" || true; }

case ${1:-} in
  info)
    send 0201 | response "02 01" ;;
  mac)
    send 0204 | response "02 04" | awk '{print toupper($3":"$4":"$5":"$6":"$7":"$8)}' ;;
  time)
    send 0203 | response "02 03" | awk '{
      y = strtonum("0x"$4$3); printf "%04d-%02d-%02d %02d:%02d:%02d (weekday %d, Mon=0)\n",
      y, strtonum("0x"$5), strtonum("0x"$6), strtonum("0x"$7), strtonum("0x"$8), strtonum("0x"$9), strtonum("0x"$10) }' ;;
  battery)
    send 0205 | response "02 05" | awk '{
      st = strtonum("0x"$6); split("normal charging full", names, " ")
      printf "%d%%  %d mV  %s\n", strtonum("0x"$7), strtonum("0x"$5$4), (st + 1 in names) ? names[st + 1] : st }' ;;
  live)
    # 02 a0: steps, calories, distance, active time as u32 LE; byte 18 = last heart rate
    send 02a0 | response "02 a0" | awk '{
      for (k = 0; k < 4; k++) { i = 3 + 4 * k; v[k] = strtonum("0x"$(i+3)$(i+2)$(i+1)$i) }
      printf "steps %d  calories %d  distance %d m  active %d min  heart rate %d\n",
        v[0], v[1], v[2], v[3], strtonum("0x"$19) }' ;;
  activity)
    send h:0803010000 sleep:6 | grep "^af2: 08 03" | python3 -c '
import sys, datetime
pk = [bytes.fromhex(l.split(":", 1)[1].strip()) for l in sys.stdin]
if len(pk) < 2:
    sys.exit("no activity data")
h = pk[0][4:]
day = datetime.datetime(h[0] | h[1] << 8, h[2], h[3])
step = h[6]
t = pk[1][4:]
u32 = lambda o: int.from_bytes(t[o:o + 4], "little")
print(f"{day:%Y-%m-%d}: steps {u32(0)}  calories {u32(4)}  distance {u32(8)} m  active {u32(12)} min")
slot = 0
for p in pk[2:]:
    d = p[4:]
    for j in range(0, len(d) - 4, 5):
        s = d[j:j + 5]
        steps = (int.from_bytes(s[0:2], "little") >> 2) & 0xFFF
        if steps:
            active = (int.from_bytes(s[1:3], "little") >> 6) & 0xF
            cal = (int.from_bytes(s[2:4], "little") >> 2) & 0x3FF
            dist = int.from_bytes(s[3:5], "little") >> 4
            ts = day + datetime.timedelta(minutes=slot * step)
            print(f"  {ts:%H:%M}  steps {steps:5d}  calories {cal:4d}  distance {dist:5d} m  active {active} min")
        slot += 1
' ;;
  find)
    send 060400 "sleep:${2:-5}" 060401 ;;
  alarms)
    # 03 02 <id> <status 55> <type 00 = wake up> <hour> <min> <repeat> <snooze>
    # repeat: bit 0 = enabled, bits 1..7 = Monday..Sunday
    file=${2:-$(dirname "$0")/alarms.txt}
    days=(MON TUE WED THU FRI SAT SUN)
    declare -A mask=()
    while read -r day times; do
      [[ -z $day ]] && continue
      idx=-1
      for i in "${!days[@]}"; do [[ ${days[i]} == "${day^^}" ]] && idx=$i; done
      (( idx >= 0 )) || { echo "unknown day: $day" >&2; exit 2; }
      for t in $times; do
        [[ $t =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || { echo "bad time: $t" >&2; exit 2; }
        key=$(printf '%02d:%02d' $((10#${BASH_REMATCH[1]})) $((10#${BASH_REMATCH[2]})))
        mask[$key]=$(( ${mask[$key]:-1} | 1 << (idx + 1) ))
      done
    done < <(sed 's/#.*//' "$file")
    mapfile -t keys < <(printf '%s\n' "${!mask[@]}" | grep . | sort)
    (( ${#keys[@]} <= 10 )) || { echo "too many distinct times: ${#keys[@]} (max 10)" >&2; exit 2; }
    cmds=()
    for ((slot = 0; slot <= 10; slot++)); do
      if (( slot >= 1 && slot <= ${#keys[@]} )); then
        k=${keys[slot - 1]}; m=${mask[$k]}
        on=""; for i in "${!days[@]}"; do (( m >> (i + 1) & 1 )) && on+="${days[i]} "; done
        echo "slot $slot: $k  $on"
        cmds+=("$(printf '0302%02x5500%02x%02x%02x00' $slot $((10#${k%:*})) $((10#${k#*:})) $m)")
      else
        cmds+=("$(printf '0302%02x5500000000' $slot)")   # disabled
      fi
    done
    acks=$(send "${cmds[@]}" | grep -c "^03 02")
    echo "$acks/${#cmds[@]} slots written"
    (( acks == ${#cmds[@]} )) ;;
  settime)
    send settime sleep:1 0203 | response "02 03" ;;
  vibrate)
    send 05010101 "sleep:${2:-4}" 0502 ;;
  notify)
    [[ $# -eq 3 ]] || { echo "usage: $0 notify <from> <text>" >&2; exit 2; }
    from=$(hex "$2"); text=$(hex "$3")
    (( ${#from} / 2 + ${#text} / 2 <= 12 )) || { echo "from+text must be <= 12 bytes" >&2; exit 2; }
    # 05 03 <total> <serial> <type 08=WhatsApp> <len from> <len number> <len text> <from> <text>
    send "$(printf '0503010108%02x00%02x' $((${#from} / 2)) $((${#text} / 2)))$from$text" ;;
  raw)
    shift; send "$@" ;;
  *)
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
